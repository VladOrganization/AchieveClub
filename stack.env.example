# --- PostgreSQL (читает контейнер postgres и подставляется в строку подключения бэка) ---
POSTGRES_DB=achieve_club
POSTGRES_USER=achieve
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME

# --- Backend: JWT (Program.cs читает ключ "jwt_key") ---
jwt_key=CHANGE_ME_LONG_RANDOM_STRING_MIN_32_CHARS

# --- Backend: Resend (EmailSettings) ---
EmailSettings__ApiKey=re_CHANGE_ME
EmailSettings__Email=no-reply@byteschool.by

# --- Backend: логи в Telegram (Serilog WriteTo[1] = Telegram) ---
Serilog__WriteTo__1__Args__botToken=CHANGE_ME
Serilog__WriteTo__1__Args__chatId=CHANGE_ME
