{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Warning",
      "Microsoft.EntityFrameworkCore.Database": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Issuer": "mobile client",
    "Audience": "web api",
    "MinutesToExpiration": "25"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=172.17.0.4;Database=achieve_club;UserId={{db_user}};Password={{db_user}};",
    "RedisConnection": "172.17.0.3"
  },
  "EmailSettings": {
    "ApiKey": "{{resend_api_key}}",
    "Email": "{{email}}",
    "Name": "no-reply"
  },
  "jwt_key": "{{jwt_key}}",
  "Google": {
    "ClientId": "{{google_client_id}}"
  },
  "Certificates": {
    "Public": "/var/letsencrypt/fullchain.pem",
    "Private": "/var/letsencrypt/privkey.pem"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Telegram.Alternative"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Warning",
        "Microsoft.EntityFrameworkCore.Database": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Telegram",
        "Args": {
          "botToken": "{{telegram_bot_token}}",
          "chatId": "{{telegram_chat_id}}",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ]
  }
}