{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Warning",
      "Microsoft.EntityFrameworkCore.Database": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "AuthenticatedPermitLimit": 2000,
    "AnonymousPermitLimit": 200,
    "WindowSeconds": 60
  },
  "JwtSettings": {
    "Issuer": "mobile client",
    "Audience": "web api",
    "MinutesToExpiration": "25"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=achieve_club;User ID={{db_user}};Password={{db_password}};",
    "RedisConnection": "127.0.0.1:6379",
    "DashboardConnection": "http://localhost:18889"
  },
  "jwt_key": "{{jwt_key}}",
  "Serilog": {
    "Using": ["Serilog.Sinks.Telegram.Alternative"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Warning",
        "Microsoft.EntityFrameworkCore.Database": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Telegram",
        "Args": {
          "botToken": "{{telegram_bot_token}}",
          "chatId": "{{telegram_chat_id}}",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ]
  }
}
